{
  "city": "{{ city|e('js') }}",
  "country": "{{ country|e('js') }}",
  "measurements": [
    {% for measurement in measurements %}
    {
      "date": "{{ measurement.date|default('')|e('js') }}",
      "celsius": {{ measurement.celsius is null ? 'null' : measurement.celsius }},
      "fahrenheit": {{ measurement.fahrenheit is null ? 'null' : measurement.fahrenheit }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
