{% extends 'base.html.twig' %}

{% block title %}Weather{% endblock %}

{% block body %}
    <h1>Weather</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ weather.id }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ weather.Date ? weather.Date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Temperature</th>
                <td>{{ weather.Temperature }}</td>
            </tr>
            <tr>
                <th>Cloud_cover</th>
                <td>{{ weather.CloudCover }}</td>
            </tr>
            <tr>
                <th>Humidity</th>
                <td>{{ weather.Humidity }}</td>
            </tr>
            <tr>
                <th>Wind_strength</th>
                <td>{{ weather.WindStrength }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_weather_index') }}">back to list</a>

    <a href="{{ path('app_weather_edit', {'id': weather.id}) }}">edit</a>

    {{ include('weather/_delete_form.html.twig') }}
{% endblock %}
